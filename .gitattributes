# Normalize text files in Git
* text=auto

# Source code
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf

# Styles and markup
*.css   text eol=lf
*.html  text eol=lf
*.svg   text eol=lf

# Configuration and documentation
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Git configuration
.gitattributes text eol=lf
.gitignore     text eol=lf
